{
  "name": "@snapshop/server",
  "version": "1.0.0",
  "private": true,
  "description": "SnapShop API: identify an item from a photo and find the best places to buy it.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0"
  }
}
