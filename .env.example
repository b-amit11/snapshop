# Copy to .env and fill in what you have. Every key is optional:
# with none set, SnapShop runs in demo mode with sample data.

# --- Photo identification (Claude vision) ---
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Online prices: Amazon, Walmart, Target, eBay... via Google Shopping ---
# https://serpapi.com (free tier: 100 searches/month)
SERPAPI_KEY=

# --- In-store prices + stock: Kroger, Harris Teeter, Ralphs, Fred Meyer... ---
# https://developer.kroger.com -> create an app (Production environment), scope product.compact
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# --- Nearby stores (Google Maps Platform) ---
# Enable "Places API (New)" and "Geocoding API" on the key.
GOOGLE_MAPS_API_KEY=

# --- Server ---
PORT=8787
SEARCH_RADIUS_MILES=10
RATE_LIMIT_PER_MINUTE=30
# Comma-separated origins allowed to call the API from a browser, or *
CORS_ORIGINS=*
# true = always use demo data (useful while working on the UI)
DEMO_MODE=false
